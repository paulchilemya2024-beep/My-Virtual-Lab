# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file — it holds your secrets.

# Port the server listens on (Render sets this automatically in production)
PORT=5000

# MongoDB Atlas connection string.
# Get this free at https://mongodb.com/atlas — create a cluster, then
# "Connect" -> "Drivers" -> copy the connection string. Replace <password>.
MONGODB_URI=mongodb://127.0.0.1:27017/stem-lab

# Secret used to sign login tokens (JWT). Make this a long random string.
# Example to generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call this API (CORS).
# In development this is your Vite dev server. In production add your Vercel URL.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional — powers the AI tutor (server/src/routes/tutor.js). Leave blank to
# run everything else in this app exactly the same; the tutor route just
# replies with a clean "not configured" message instead of calling out.
# Get a free key, no card required, at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# A free-tier "flash-lite" model. Google renames/retires these fairly often —
# if this 404s, query https://generativelanguage.googleapis.com/v1beta/models
# with your own key to see the current real model names for your account
# rather than trusting a blog post's list (several are already stale).
GEMINI_MODEL=gemini-3.5-flash-lite
# Hard daily cap on tutor requests, comfortably under Gemini's free-tier limit
# so a spike degrades gracefully instead of exhausting the whole day's quota.
TUTOR_DAILY_BUDGET=1400
